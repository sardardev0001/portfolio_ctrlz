# Copy to .env and replace all development values. Do not commit .env.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_HOST=postgres
POSTGRES_DB=ctrlz
POSTGRES_USER=ctrlz
POSTGRES_PASSWORD=replace-with-strong-database-password
SEED_ADMIN_USERNAME=ctrlz-admin
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ctrlz-local
S3_SECRET_KEY=replace-with-strong-storage-secret
S3_BUCKET=ctrlz
S3_REGION=us-east-1
MINIO_ROOT_USER=ctrlz-local
MINIO_ROOT_PASSWORD=replace-with-strong-storage-secret

# Optional: use a trusted already-built MinIO image for offline local setup.
MINIO_IMAGE=ctrlz-minio:source-2025-10-15

API_PROXY_TOKEN=replace-with-a-shared-random-proxy-token
