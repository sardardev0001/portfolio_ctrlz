# This template contains NO real credentials. Keep production outside releases.
# Generate fresh values with configure.py; never reuse development credentials.
DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=ctrtlzweb.ir,www.ctrtlzweb.ir,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ctrtlzweb.ir,https://www.ctrtlzweb.ir
CORS_ALLOWED_ORIGINS=https://ctrtlzweb.ir,https://www.ctrtlzweb.ir
NEXT_PUBLIC_SITE_URL=https://ctrtlzweb.ir
SITE_URL=https://ctrtlzweb.ir
SECURE_SSL_REDIRECT=false
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
POSTGRES_HOST=postgres
POSTGRES_DB=ctrlz
POSTGRES_USER=ctrlz
POSTGRES_PASSWORD=
# Empty uses the persistent media_prod filesystem volume (small VPS profile).
# For S3/MinIO set endpoint AND COMPOSE_PROFILES=s3 and verify MINIO_IMAGE.
S3_ENDPOINT_URL=
COMPOSE_PROFILES=
S3_ACCESS_KEY=ctrlz-production
S3_SECRET_KEY=
S3_BUCKET=ctrlz-production
S3_REGION=us-east-1
MINIO_ROOT_USER=ctrlz-production
MINIO_ROOT_PASSWORD=
# Set to a verified registry image/digest or a verified locally built image.
MINIO_IMAGE=
API_PROXY_TOKEN=
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
BACKEND_MEMORY_LIMIT=384m
FRONTEND_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=192m
MINIO_MEMORY_LIMIT=512m
